---
import Default from "@astrojs/starlight/components/PageTitle.astro";
import VersionNotice from "starlight-versions/components/VersionNotice.astro";
import { markdownPathFromEntryId } from "../lib/docs-routes";

const { entry } = Astro.locals.starlightRoute;
const isNotFound = entry.id === "404" || entry.id.endsWith("/404");
const markdownPath =
  isNotFound || entry.data.draft
    ? undefined
    : markdownPathFromEntryId(entry.id);
---

<Default />
<VersionNotice />
{
  markdownPath && (
    <a
      href={markdownPath}
      rel="alternate"
      type="text/markdown"
      class="mt-4 inline-flex items-center gap-2 rounded-sm text-sm text-[var(--sl-color-gray-2)] no-underline hover:text-[var(--sl-color-accent-high)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sl-color-accent)]"
    >
      <svg
        class="size-4 shrink-0"
        viewBox="0 0 24 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <rect x="1" y="1" width="22" height="14" rx="2" />
        <path d="M5 12V4l4 5 4-5v8M18 4v7m-3-3 3 3 3-3" />
      </svg>
      View as Markdown
    </a>
  )
}
