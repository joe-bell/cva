---
import { getEntry } from "astro:content";

import type { BundleSizePackage } from "../lib/bundle-size-sources";

export interface Props {
  package: BundleSizePackage;
}

const { package: packageName } = Astro.props;
const entry = await getEntry("bundleSizes", packageName);
if (entry === undefined)
  throw new Error(`Missing ${packageName} bundle size report.`);
---

<span>{entry.data.formattedSize}</span>
